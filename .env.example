# ---------------------------------------------------------------------------
# Push-notification server — environment variables.
# These are set in  Vercel → your project → Settings → Environment Variables.
# NEVER put the real values in a file you commit, and never in any js/ file.
# ---------------------------------------------------------------------------

# REQUIRED — the Firebase service-account key (Firebase Console → Project settings → Service accounts → Generate new private key).
# Paste the WHOLE .json file as ONE line … or, safer to paste, its base64 form (use ONE of the two):
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_B64=

# REQUIRED for scheduled notifications — a long random text (at least 32 characters).
# The free scheduler (cron-job.org / GitHub Actions) sends it as   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# OPTIONAL
# Your site's address; the default is Vercel's production domain of this project.
SITE_URL=https://tvexam.vercel.app
# Extra origins allowed to call the API (comma separated) — only if the website itself is hosted somewhere else.
PUSH_ALLOWED_ORIGINS=
# Safety limits (defaults shown)
PUSH_MAX_RECIPIENTS=5000
PUSH_ADMIN_PER_HOUR=20
PUSH_ADMIN_PER_DAY=80
PUSH_FUNCTION_BUDGET_MS=7500
