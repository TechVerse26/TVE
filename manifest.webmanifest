{
  "id": "./",
  "name": "Tech Verse Exam",
  "short_name": "Tech Verse",
  "description": "Your exams, practice sessions, and results — all in one convenient app experience.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A1B4D",
  "theme_color": "#0A1B4D",
  "categories": ["education"],
  "icons": [
    { "src": "assets/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/pwa/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/pwa/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "All Exams", "short_name": "Exams", "url": "./#/exams", "icons": [{ "src": "assets/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Exam Schedule", "short_name": "Schedule", "url": "./#/schedule", "icons": [{ "src": "assets/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "My Results", "short_name": "Results", "url": "./#/results", "icons": [{ "src": "assets/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "https://tvexam.vercel.app/manifest.webmanifest" }
  ]
}
