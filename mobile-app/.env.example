# Copy to .env.local for local builds. Nothing here is secret — it is only configuration.
# Where the website (and its /api/push serverless API) lives. Used for push registration,
# the admin "Send push" screen and the server-clock check.
VITE_SITE_URL=https://tvexam.vercel.app
# Optional: use a different push-API host than VITE_SITE_URL.
VITE_API_BASE=
VITE_APP_VERSION=1.0.0
