{
  "name": "tech-verse-exam-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tech Verse Exam \u2014 native Android app (React + TypeScript + Ionic + Capacitor). Shares the website's Firebase project.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/sync-shared.mjs && vite build",
    "preview": "vite preview",
    "test": "node scripts/sync-shared.mjs --check && node --import tsx --test \"tests/*.test.ts\"",
    "android:init": "npm run build && node scripts/android.mjs init",
    "android:sync": "npm run build && node scripts/android.mjs sync",
    "android:debug": "npm run android:sync && node scripts/android.mjs build debug",
    "android:release": "npm run android:sync && node scripts/android.mjs build release",
    "android:open": "npx cap open android",
    "test:e2e": "node tests/e2e/build.mjs && python3 tests/e2e/run.py"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@ionic/react": "^8.4.0",
    "@ionic/react-router": "^8.4.0",
    "firebase": "^10.14.1",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
